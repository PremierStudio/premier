{
  "name": "@premier/web",
  "license": "Apache-2.0 OR MIT",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:glass": "node --test tests/*.test.ts",
    "test:review": "node --test tests/reviewLogic.test.ts tests/sessionReplay.test.ts",
    "test:all": "pnpm run test && pnpm run test:glass && pnpm run test:review",
    "test:smoke": "node tests/smoke-live.mjs",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "monaco-editor": "^0.58.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "vitest": "^5.1.1"
  }
}
