{
  "name": "@premierstudio/trace",
  "version": "0.1.0",
  "description": "Minimal first-party emitter for Premier agent traces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "node --test test/emit.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PremierStudio/premier.git",
    "directory": "sdk/js"
  },
  "homepage": "https://premier.dev/docs/sdk"
}
