version = 1
repo_id = "acme/platform"

[vars.APP_ENV]
type = "string"
sensitivity = "public"
default = "development"
allowed_values = ["development", "preview", "staging", "production"]
required_in = ["dev", "preview", "staging", "prod"]

[vars.PORT]
type = "int"
sensitivity = "public"
default = "3000"
required_in = ["dev", "prod"]

[vars.STRIPE_API_KEY]
type = "secret"
sensitivity = "restricted"
required_in = ["staging", "prod"]
zone = "billing"
description = "Stripe secret key — agents may USE only against api.stripe.com"

[vars.STRIPE_API_KEY.egress]
hosts = ["api.stripe.com"]
methods = ["GET", "POST"]
path_prefixes = ["/v1/"]
inject = { kind = "bearer_header", header = "Authorization" }
rate_limit_per_min = 60
approval = "auto"

[vars.GITHUB_TOKEN]
type = "secret"
sensitivity = "restricted"
required_in = ["prod"]
description = "GitHub API token gated by per-capability JIT approval"

[vars.GITHUB_TOKEN.egress]
hosts = ["api.github.com"]
methods = ["GET", "POST"]
path_prefixes = ["/repos/", "/user"]
inject = { kind = "placeholder_replace" }
rate_limit_per_min = 120
approval = "jit"
jit_ttl_secs = 300
